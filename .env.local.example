# Copy to .env.local and fill in from your Supabase project
# (Project settings → API). Never commit the real file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Web push notifications (Phase 6) ---
# Generate a keypair once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@yourdomain.com

# Service role key (Project settings → API → service_role). Server-only — never
# expose to the client. Used by /api/push/dispatch to read subscriptions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the Supabase Database Webhook sends as the x-webhook-secret
# header so only Supabase can trigger a push dispatch. Make it long + random.
PUSH_WEBHOOK_SECRET=a-long-random-string
